# ─────────────────────────────────────────────────────────────────────────────
# FIREBASE CLOUD CONFIGURATION (TEMPLATE)
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and populate with your own project credentials:
# cp .env.example .env.local
#
# Obtain these credentials from:
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/configuration
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
